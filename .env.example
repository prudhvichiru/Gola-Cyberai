# ==============================================================================
# GOLA CYBERAI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env in backend/ and frontend/ and populate with
# authoritative production credentials. NEVER commit raw credentials to Git.

# --- SERVER & NETWORKING ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://gola.internal
NEXT_PUBLIC_API_URL=https://gola.internal/api

# --- SUPABASE / POSTGRESQL PERSISTENCE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- RATE LIMITING & SECURITY THRESHOLDS ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=10

# --- WEBSOCKET REAL-TIME COLLABORATION ---
WS_HEARTBEAT_INTERVAL_MS=30000
NEXT_PUBLIC_WS_URL=wss://gola.internal/ws

# --- FILE STORAGE & OBJECT ACCESS ---
STORAGE_BUCKET_ATTACHMENTS=gola-attachments
STORAGE_BUCKET_DOCUMENTS=gola-documents
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document
